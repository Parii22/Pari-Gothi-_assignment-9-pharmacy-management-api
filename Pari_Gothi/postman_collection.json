    {
      "name": "3. Medicine Inventory Management",
      "item": [
        {
          "name": "Browse Medicine Catalog (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medicines?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Medicines by Name & Category (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medicines?search=Amoxicillin&category=Antibiotic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"],
              "query": [
                { "key": "search", "value": "Amoxicillin" },
                { "key": "category", "value": "Antibiotic" }
              ]
            }
          }
        },
        {
          "name": "Add Medicine (Pharmacist Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('medicineId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin 500mg\",\n  \"brand\": \"Amoxil\",\n  \"category\": \"Antibiotic\",\n  \"dosageForm\": \"Capsule\",\n  \"price\": 18.50,\n  \"stockQuantity\": 100,\n  \"requiresPrescription\": true,\n  \"expiryDate\": \"2026-12-31T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"]
            }
          }
        },
        {
          "name": "Add OTC Medicine (Admin Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Paracetamol 500mg\",\n  \"brand\": \"Panadol\",\n  \"category\": \"Analgesic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 5.00,\n  \"stockQuantity\": 250,\n  \"requiresPrescription\": false,\n  \"expiryDate\": \"2027-06-30T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"]
            }
          }
        },
        {
          "name": "RBAC Test: Customer Attempt Add Medicine (Expect 403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ibuprofen 400mg\",\n  \"brand\": \"Advil\",\n  \"category\": \"Analgesic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 8.00,\n  \"stockQuantity\": 50,\n  \"requiresPrescription\": false,\n  \"expiryDate\": \"2026-08-15T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines"]
            }
          }
        },
        {
          "name": "Update Stock / Price (Pharmacist Token)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockQuantity\": 120,\n  \"price\": 19.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "{{medicineId}}"]
            }
          }
        },
        {
          "name": "Get Expiring Medicines (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medicines/expiring",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "expiring"]
            }
          }
        },
        {
          "name": "RBAC Test: Pharmacist Attempt Delete Medicine (Expect 403 Forbidden)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "{{medicineId}}"]
            }
          }
        },
        {
          "name": "Delete Medicine (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "medicines", "{{medicineId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Order & Prescription Processing",
      "item": [
        {
          "name": "Test: Place Order without Prescription Notes (Expect 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicineId\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Place Order with Prescription Notes (Customer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('orderId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicineId\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"prescriptionNotes\": \"Doctor John Doe, Rx# 98234, 1 capsule twice daily after meals\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "View My Orders (Customer Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "List All Orders across System (Pharmacist / Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "status", "value": "pending" }
              ]
            }
          }
        },
        {
          "name": "Approve Order & Trigger Atomic Stock Deduction (Pharmacist Token)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Mark Order as Dispensed (Pharmacist Token)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dispensed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
