            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Pharmacist\",\n  \"email\": \"bob.pharmacist@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"pharmacist\",\n  \"adminKey\": \"{{adminKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register-staff"]
            }
          }
